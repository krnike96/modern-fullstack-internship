generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  email     String   @unique
  createdAt DateTime @default(now())
}

model FoodItems {
  id        Int    @id @default(autoincrement())
  itemName  String
  price     Int
  category  String
}
