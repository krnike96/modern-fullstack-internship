generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Customer {
  cust_id  Int     @id @default(autoincrement())
  name     String
  email    String  @unique
  password String
  orders   Order[]
}

model MenuItem {
  item_id   Int     @id @default(autoincrement())
  item_name String
  price     Int
  category  String
  orderItems OrderItem[]
}

model Order {
  order_id   Int      @id @default(autoincrement())
  total      Int
  created_at DateTime @default(now())
  status     String   @default("pending")
  cust_id    Int
  customer   Customer @relation(fields: [cust_id], references: [cust_id])
  items      OrderItem[]
  @@map("orders")
}

model OrderItem {
  order_id  Int
  item_id   Int
  quantity  Int
  order     Order    @relation(fields: [order_id], references: [order_id])
  item      MenuItem @relation(fields: [item_id], references: [item_id])
  @@id([order_id, item_id])
  @@map("order_items")
}